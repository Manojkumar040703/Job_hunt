# =================================================================
# Job Hunt Platform — Environment Configuration Template
# =================================================================

# --- Frontend Environment Variables (Vite) ---
# When deployed on Vercel or Render, point to the live FastAPI backend URL
VITE_API_URL=http://localhost:8000/api

# --- Backend Environment Variables (FastAPI) ---
PROJECT_NAME="Job Hunt — Tamil Nadu Career Platform"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase / Render PostgreSQL)
# Example for PostgreSQL: postgresql://username:password@hostname:5432/jobhunt_db
# Example for local development SQLite fallback: sqlite:///./jobhunt.db
DATABASE_URL=sqlite:///./jobhunt.db

# Initial System Accounts (Auto-seeded on first run)
ADMIN_NAME="Manoj"
ADMIN_EMAIL="manoj@demo.com"
ADMIN_PASSWORD="AdminSecure@2026"

RECRUITER_NAME="Raj"
RECRUITER_EMAIL="raj@demo.com"
RECRUITER_PASSWORD="Recruiter@Raj2026"
RECRUITER_COMPANY="Apex Mobility"

CANDIDATE_NAME="Hari"
CANDIDATE_EMAIL="hari@demo.com"
CANDIDATE_PASSWORD="Candidate@Hari2026"

# Email SMTP Delivery (Optional — Simulated delivery enabled by default)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAILS_FROM_EMAIL=notifications@jobhunt.tn.gov.in
EMAILS_FROM_NAME="Job Hunt Tamil Nadu"

# File Upload Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# Payment Gateway (UPI / Razorpay Sandbox Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
